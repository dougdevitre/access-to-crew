# Block Crew API configuration.
#
# The service boots with none of these set: /healthz always works and
# reports which dependencies are configured. Endpoints that need a missing
# dependency return 503 (fail closed) until it is provided.

# --- Core (defaults exist) ---
NODE_ENV=development
PORT=8080
# Allowed browser origin. The default is the local Vite dev port; set your
# real frontend origin in production.
CORS_ORIGIN=http://localhost:5173

# --- Anthropic (required for POST /v1/classify) ---
# The Tier-0 classifier model call.
ANTHROPIC_API_KEY=
# Optional override of the classifier model (default: claude-opus-5).
# TIER0_MODEL=claude-opus-5

# --- Clerk auth (required for any authenticated endpoint) ---
# Without this, protected routes return 503 rather than accepting anything.
CLERK_SECRET_KEY=
# Optional PEM public key for networkless token verification.
# CLERK_JWT_KEY=

# --- Postgres (required for classification persistence + future features) ---
# Needs PostGIS + pgcrypto (Neon and Supabase both support them).
# For serverless deployments use a pooled connection string with
# sslmode=require. Run `npm run migrate -w @blockcrew/api` against it once.
DATABASE_URL=

# --- St. Louis CSB / Open311 ingest ---
CSB_OPEN311_URL=

# --- Future S3 evidence uploads (declared, not yet wired) ---
EVIDENCE_BUCKET=
AWS_REGION=us-east-2
